[
  {"Species": "Greater White-fronted Goose", "Scientific Name": "Anser albifrons", "Target Subspecies": ["Anser albifrons elgasi"], "Vermont Subspecies": ["Anser albifrons flavirostris"], "Note": "May occur in the Northeast. Evidence not completely compelling yet."},
  {"Species": "Canada Goose", "Scientific Name": "Branta canadensis", "Target Subspecies": ["Branta canadensis parvipes"], "Vermont Subspecies": ["Branta canadensis [canadensis Group]", "Branta canadensis moffitti/maxima"], "Note": "May occur, but variability in resident and migrant Canadas make ID problematic."},
  {"Species": "Cackling Goose", "Scientific Name": "Branta hutchinsii", "Target Subspecies": ["Branta hutchinsii taverneri"], "Vermont Subspecies": ["Branta hutchinsii hutchinsii"], "Note": "Has been claimed on at least two occasions from Massachusetts and possibly seen once (but not reported to VBRC) in southern VT."},
  {"Species": "Brant", "Scientific Name": "Branta bernicla", "Target Subspecies": ["Branta bernicla nigricans"], "Vermont Subspecies": ["Branta bernicla hrota"], "Note": "Has been recorded in MA."},
  {"Species": "Green-winged Teal", "Scientific Name": "Anas crecca", "Target Subspecies": ["Anas crecca crecca"], "Vermont Subspecies": ["Anas crecca carolinensis"], "Note": "1-2 records from VT. Probably under-recorded."},
  {"Species": "Red-tailed Hawk", "Scientific Name": "Buteo jamaicensis", "Target Subspecies": ["Buteo jamaicensis calurus/alascensis", "Buteo jamaicensis harlani"], "Vermont Subspecies": ["Buteo jamaicensis borealis", "Buteo jamaicensis abieticola"], "Note": "Western and/or dark-morphs are a possibility having been seen in western Mass and New York"},
  {"Species": "Willet", "Scientific Name": "Tringa semipalmata", "Target Subspecies": ["Tringa semipalmata semipalmata", "Tringa semipalmata inornata"], "Vermont Subspecies": [], "Note": "Most Willets occurring in VT likely to be westerns, but not known for sure."},
  {"Species": "Short-billed Dowitcher", "Scientific Name": "Limnodromus griseus", "Target Subspecies": ["Limnodromus griseus hendersoni"], "Vermont Subspecies": ["Limnodromus griseus griseus", "Limnodromus griseus hendersoni"], "Note": "About 10% of autumn coastal birds are this race. Likely to occur in VT."},
  {"Species": "Iceland Gull", "Scientific Name": "Larus glaucoides", "Target Subspecies": ["Larus glaucoides glaucoides"], "Vermont Subspecies": ["Larus glaucoides kumlieni", "Larus glaucoides thayeri", "Larus glaucoides thayeri/kumlieni"], "Note": "Most, if not all, L. glaucoides reported in VT are called “Iceland”, but are more likely to be Kumliens gulls. Icelands (glaucoides) may rarely occur but this needs verification."},
  {"Species": "Lesser Black-backed Gull", "Scientific Name": "Larus fuscus", "Target Subspecies": ["Larus fuscus intermedius", "Larus fuscus fuscus", "Larus fuscus heuglini", "Larus fuscus barabensis"], "Vermont Subspecies": ["Larus fuscus graellsii"], "Note": "Any race other than graellsii. Possible that other European races occur, most likely intermedius."},
  {"Species": "Northern Flicker", "Scientific Name": "Colaptes auratus", "Target Subspecies": ["Colaptes auratus [cafer Group]"], "Vermont Subspecies": ["Colaptes auratus auratus/luteus"], "Note": "Do red-shafteds occur in VT? Intergrades have been recorded at banding stations in MA."},
  {"Species": "Horned Lark", "Scientific Name": "Eremophila alpestris", "Target Subspecies": [""], "Vermont Subspecies": [], "Note": "Any race other than praticola (Hoyti and alpestris most likely). Both Hoyti and alpestris recorded in NH. Probably under-recorded."},
  {"Species": "Northern Wheatear", "Scientific Name": "Oenanthe oenanthe", "Target Subspecies": ["Oenanthe oenanthe leucorhoa"], "Vermont Subspecies": ["Oenanthe oenanthe leucorhoa"], "Note": "Most northern wheaters seen in VT are most likely to be of this race. Unfortunately, few are identified to subspecies."},
  {"Species": "Yellow-rumped Warbler", "Scientific Name": "Setophaga coronata", "Target Subspecies": ["Setophaga coronata auduboni"], "Vermont Subspecies": ["Setophaga coronata coronata"], "Note": "Recorded in other New England states, usually in midwinter at feeding stations."},
  {"Species": "Savannah Sparrow", "Scientific Name": "Passerculus sandwichensis", "Target Subspecies": ["Passerculus sandwichensis princeps"], "Vermont Subspecies": ["Passerculus sandwichensis [sandwichensis Group]"], "Note": "Mainly coastal, but has been recorded inland in MA. Possibly under-recorded?"},
  {"Species": "Fox Sparrow", "Scientific Name": "Passerella iliaca", "Target Subspecies": [""], "Vermont Subspecies": ["Passerella iliaca iliaca/zaboria"], "Note": "One of the dark races may have been seen in NH, but record may be a melanistic iliaca."},
  {"Species": "White-crowned Sparrow", "Scientific Name": "Zonotrichia leucophrys", "Target Subspecies": ["Zonotrichia leucophrys gambelii"], "Vermont Subspecies": ["Zonotrichia leucophrys leucophrys"], "Note": ""},
  {"Species": "Nelson's Sparrow", "Scientific Name": "Ammospiza nelsoni", "Target Subspecies": ["Ammospiza nelsoni subvirgata"], "Vermont Subspecies": ["Ammospiza nelsoni nelsoni/altera"], "Note": "Any claims of subvirgatus need documentation and review."},
  {"Species": "Dark-eyed Junco", "Scientific Name": "Junco hyemalis", "Target Subspecies": [""], "Vermont Subspecies": ["Junco hyemalis hyemalis/carolinensis"], "Note": "Any race other than slate-colored"},
  {"Species": "Redpoll", "Scientific Name": "Acanthis flammea", "Target Subspecies": ["Acanthis flammea rostrata/islandica", "Acanthis flammea hornemanni"], "Vermont Subspecies": ["Acanthis flammea flammea", "Acanthis flammea flammea/rostrata/islandica"], "Note": "Common and Hoary Redpoll were lumped in 2024. Greenland (rostrata/islandica) is under-recorded; Hornemann's (hornemanni) may have been photographed in the state and should be watched for closely. Every other form, Hoary (exilipes) and Lesser (cabaret) included, is flagged too."}
]
